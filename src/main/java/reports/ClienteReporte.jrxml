	<queryString language="SQL">
		<![CDATA[SELECT id,
       nombre,
       apellido,
       correo,
       direccion,
       telefono,
       TO_CHAR(ingreso, 'YYYY-MM-DD') AS ingreso,
       status
FROM clientes
ORDER BY id]]>
